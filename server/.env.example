# Google Generative AI (Gemini) Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=your_supabase_api_key_here

# Admin Configuration
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Server Configuration
SERVER_PORT=3001

# Cron Schedule Configuration
# Morning odds scrape time (24-hour format HH:MM)
MORNING_SCRAP_TIME=08:00

# Racing day scrape start time (24-hour format HH:MM)
RACING_START_TIME=12:00

# Racing day scrape end time (24-hour format HH:MM)
RACING_END_TIME=22:00

# Racing day scrape interval in seconds (default: 300 = 5 minutes)
RACING_SCRAP_INTERVAL=300

# Node Environment
NODE_ENV=production
