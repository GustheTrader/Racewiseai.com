# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Admin Emails (comma-separated)
# Format: VITE_ADMIN_EMAILS="admin1@example.com,admin2@example.com"
VITE_ADMIN_EMAILS=

# Developer Account Credentials (for development/testing only)
# Only set these in secure development environments
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
VITE_DEV_NAME=Developer

# Off-Track Betting Credentials (must be set in Supabase environment variables)
# These should NEVER be in client-side code
# OTB_USERNAME=your_username
# OTB_PASSWORD=your_password

# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
