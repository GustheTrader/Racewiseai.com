# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration (Required)
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Admin Emails (Required for admin access)
# Comma-separated list of email addresses that should have admin privileges
# Example: VITE_ADMIN_EMAILS="admin@example.com,owner@example.com"
VITE_ADMIN_EMAILS=

# API Configuration (Optional)
VITE_API_BASE_URL=http://localhost:3000

# Feature Flags (Optional)
VITE_ENABLE_MOCK_DATA=true

# ============================================
# SECURITY NOTES:
# ============================================
# 
# 1. NEVER commit .env files to version control
#    (already in .gitignore)
#
# 2. Private API keys (OTB credentials, service role keys)
#    should ONLY be stored in Supabase Edge Function secrets,
#    never in client-side environment variables
#
# 3. VITE_* variables are exposed to the browser -
#    only use for publishable/public keys
#
# 4. For production, configure environment variables
#    through your hosting provider's dashboard
# ============================================
